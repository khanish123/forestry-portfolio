# Absolute URL of the deployed site (used for SEO metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: a form endpoint (e.g. Formspree "https://formspree.io/f/xxxxxxx").
# If empty, the contact form opens the visitor's email client with a pre-filled message.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
